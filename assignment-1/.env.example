# Course OpenAI-compatible endpoint. Copy this file to .env, then use the
# base URL and key distributed for the course.
OPENAI_BASE_URL=replace-with-course-base-url
OPENAI_API_KEY=replace-with-your-key
OPENAI_MODEL=deepseek/deepseek-v4-flash-0731

# Sandbox provider for running the assignment. Daytona is the default; set to
# "modal" to fall back to the original Modal-based sandbox.
ASSIGNMENT_SANDBOX_BACKEND=daytona
DAYTONA_API_KEY=replace-with-your-daytona-api-key

# The OpenAI SDK already retries transient failures twice. The harness raises
# this to five by default; override it here only when debugging provider issues.
OPENAI_MAX_RETRIES=5
